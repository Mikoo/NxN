# PawSentry AI — Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# If keys are omitted, PawSentry AI automatically runs in offline simulation/mock mode.

# --- Nebius Token Factory (Multimodal Vision & Reasoning) ---
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
NEBIUS_REASONING_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# --- Tavily Search API (Evidence-Based Veterinary Triage) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Simulation / Offline Testing ---
USE_MOCKS=false
