# Nebius Token Factory API Key (from your Nebius account / Builder program)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Models to use (NVIDIA open source models on Nebius)
# Vision / Multimodal Model:
NEBIUS_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
# Reasoning / Text Model:
NEBIUS_REASONING_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Tavily API Key (for real-time veterinary knowledge lookup - eligible for  prize!)
TAVILY_API_KEY=your_tavily_api_key_here

# Camera settings (0 is usually your laptop / default webcam, 1 or 2 for external USB cameras)
CAMERA_INDEX=0
